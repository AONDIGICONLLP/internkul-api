# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the React app (used in e-mail links and CORS)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /api/v1/docs (set false to hide). PUBLIC_API_URL = the https URL shown in Swagger "Servers" when behind a proxy
ENABLE_DOCS=true
PUBLIC_API_URL=

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgres://lms:lms@localhost:5432/internkul_lms

# ── Auth ─────────────────────────────────────────────────
# generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=14

# ── Seed admin (npm run seed:admin) ──────────────────────
ADMIN_EMAIL=admin@internkul.com
# quote the value if it contains # or spaces
ADMIN_PASSWORD="ChangeMe#2026"

# ── Payments ─────────────────────────────────────────────
# razorpay = live gateway | mock = local development without keys (disabled when NODE_ENV=production)
PAYMENT_DRIVER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── File uploads (course documents) ──────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ── E-mail (leave SMTP_HOST empty to log e-mails to the console) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Internkul" <no-reply@internkul.com>
